{
  "name": "finance-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:webapp": "vite --config webapp/vite.config.ts",
    "build:webapp": "vite build --config webapp/vite.config.ts",
    "deploy:dev": "npm run build:webapp && wrangler deploy",
    "deploy:prod": "npm run build:webapp && wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "secrets:dev": "wrangler secret bulk .dev.vars",
    "secrets:prod": "wrangler secret bulk .prod.vars --env production",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "eval": "tsx scripts/eval.ts",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webapp",
    "test": "vitest run"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true
  }
}
